# ==============================================================================
# JNOVAMUSIC ENVIRONMENT CONFIGURATION TEMPLATE
# Salin file ini menjadi .env dan masukkan kredensial resmi Anda.
# JANGAN PERNAH MEMASUKKAN SERVICE ROLE KEY KE SINI.
# ==============================================================================

# SUPABASE CONFIGURATION
# Dapatkan dari Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-publishable-key

# GOOGLE GEMINI AI CONFIGURATION
# Cara mendapatkan API Key resmi gratis:
# 1. Kunjungi Google AI Studio: https://aistudio.google.com/
# 2. Login dengan akun Google Anda
# 3. Klik "Get API key" -> "Create API key"
# 4. Salin kunci (berawalan AIzaSy...) dan tempel di bawah:
#
# Metode Konfigurasi yang Didukung:
# a. File .env (GEMINI_API_KEY=AIzaSy...)
# b. Langsung di Aplikasi via ikon kunci di header Jnova AI (dengan fitur Uji Koneksi langsung)
# c. Environment Variable OS / Server (export GEMINI_API_KEY=AIzaSy...)
# d. Compile-time flag (--dart-define=GEMINI_API_KEY=AIzaSy...)
#
# Pilihan Model yang Didukung:
# - gemini-1.5-flash (Rekomendasi Cepat & Hemat Kuota)
# - gemini-2.0-flash (Kecepatan Sangat Tinggi)
# - gemini-2.5-flash (Model Terbaru)
# - gemini-1.5-pro   (Penalaran Musik Mendalam)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

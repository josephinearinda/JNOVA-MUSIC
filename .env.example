# Salin file ini menjadi .env dan isi kredensial client Supabase.
# Jangan pernah memasukkan service-role key atau Gemini API key ke aplikasi.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-publishable-key

# GEMINI_API_KEY dikelola sebagai secret Supabase Edge Function.
# Lihat langkah konfigurasi di README.md.
